# =========================
# YouTube Data API v3
# =========================
# Create an API key at https://console.cloud.google.com/
YOUTUBE_API_KEY=

# =========================
# Google Gemini (AI summaries)
# =========================
# Create an API key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# =========================
# SMTP (email notifications)
# =========================
# For Gmail:
#   1) Enable 2-Step Verification in your Google Account security settings.
#   2) Create an app password (https://myaccount.google.com/apppasswords).
#   3) Enter the app password below as SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASSWORD=app_password_here
SMTP_FROM=your_gmail@gmail.com
NOTIFY_TO=your_email@example.com

# =========================
# Telegram Bot (mobile push notifications)
# =========================
# 1) Find @BotFather in Telegram and create a bot with the /newbot command.
#    Choose a bot name and username to receive its token.
# 2) Find your bot in Telegram and send /start.
# 3) Set TELEGRAM_BOT_TOKEN below, then run
#    python tools/find_telegram_chat_id.py to print the chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# =========================
# Optional: Streamlit Cloud DB sync -> GitHub repo
# =========================
# To commit database changes from the web app to youtube_monitor.db in GitHub,
# provide a fine-grained personal access token.
# Permission required: Contents read and write for your repository.
REPO_SYNC_TOKEN=
GITHUB_REPO=AdwaitTarpe/youtube-monitor
GITHUB_BRANCH=main
DB_REPO_PATH=youtube_monitor.db
