# Paste these values into Streamlit Community Cloud.
# Create an app at share.streamlit.io, then enter them under Advanced > Secrets.

YOUTUBE_API_KEY = "your_youtube_api_key"
GOOGLE_API_KEY = "your_google_api_key"
GEMINI_MODEL = "gemini-3.5-flash"

# App password for protecting access to the public cloud URL.
APP_PASSWORD = "choose_a_password_at_least_8_characters_long"

# Optional: also commit database changes from the web app to GitHub.
# Fine-grained personal access token permission: Contents read and write.
REPO_SYNC_TOKEN = "your_github_fine_grained_token"
GITHUB_REPO = "AdwaitTarpe/youtube-monitor"
GITHUB_BRANCH = "main"
DB_REPO_PATH = "youtube_monitor.db"
